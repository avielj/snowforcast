{
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        },
        {
            "src": "forecast.html",
            "use": "@vercel/static"
        },
        {
            "src": "forecast-dark.html",
            "use": "@vercel/static"
        },
        {
            "src": "forecast-modern.html",
            "use": "@vercel/static"
        },
        {
            "src": "forecast_new.html",
            "use": "@vercel/static"
        },
        {
            "src": "guides/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "guides/data/*.json",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sw-vt.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sw-alpe.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sw-lp.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-tokens.css",
            "use": "@vercel/static"
        },
        {
            "src": "guides/map-shared.css",
            "use": "@vercel/static"
        },
        {
            "src": "guides/map-shared.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/favicon.svg",
            "use": "@vercel/static"
        },
        {
            "src": "guides/guide-i18n.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/supabase-config.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-auth.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-sync.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-stats.js",
            "use": "@vercel/static"
        },
        {
            "src": "home.html",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-hub.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-hub.css",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-me.css",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-friends.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-recap.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-vacations.js",
            "use": "@vercel/static"
        },
        {
            "src": "guides/sf-share.js",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "dest": "/guides/index.html",
            "src": "/guides/?"
        },
        {
            "dest": "/guides/$1.html",
            "src": "/guides/(val-thorens|la-plagne|alpe-d-huez|map-val-thorens|map-la-plagne|map-alpe-d-huez|privacy|recap|share)/?"
        },
        {
            "dest": "app.py",
            "src": "/forecast.html"
        },
        {
            "dest": "/forecast-dark.html",
            "src": "/forecast-dark.html"
        },
        {
            "dest": "/forecast-modern.html",
            "src": "/forecast-modern.html"
        },
        {
            "dest": "/forecast_new.html",
            "src": "/forecast_new.html"
        },
        {
            "dest": "app.py",
            "src": "/api/(.*)"
        },
        {
            "dest": "app.py",
            "src": "/data/(.*)"
        },
        {
            "dest": "app.py",
            "src": "/share/(.*)"
        },
        {
            "dest": "app.py",
            "src": "/share-card/(.*)"
        },
        {
            "dest": "/guides/data/$1",
            "src": "/guides/data/(.*)"
        },
        {
            "dest": "/guides/sw-vt.js",
            "src": "/guides/sw-vt.js"
        },
        {
            "dest": "/guides/sw-alpe.js",
            "src": "/guides/sw-alpe.js"
        },
        {
            "dest": "/guides/sw-lp.js",
            "src": "/guides/sw-lp.js"
        },
        {
            "dest": "/guides/sf-tokens.css",
            "src": "/guides/sf-tokens.css"
        },
        {
            "dest": "/guides/map-shared.css",
            "src": "/guides/map-shared.css"
        },
        {
            "dest": "/guides/map-shared.js",
            "src": "/guides/map-shared.js"
        },
        {
            "dest": "/guides/favicon.svg",
            "src": "/guides/favicon.svg"
        },
        {
            "dest": "/guides/guide-i18n.js",
            "src": "/guides/guide-i18n.js"
        },
        {
            "dest": "/guides/supabase-config.js",
            "src": "/guides/supabase-config.js"
        },
        {
            "dest": "/guides/sf-auth.js",
            "src": "/guides/sf-auth.js"
        },
        {
            "dest": "/guides/sf-sync.js",
            "src": "/guides/sf-sync.js"
        },
        {
            "dest": "/guides/sf-stats.js",
            "src": "/guides/sf-stats.js"
        },
        {
            "dest": "/guides/sf-hub.js",
            "src": "/guides/sf-hub.js"
        },
        {
            "dest": "/guides/sf-hub.css",
            "src": "/guides/sf-hub.css"
        },
        {
            "dest": "/guides/sf-me.css",
            "src": "/guides/sf-me.css"
        },
        {
            "dest": "/guides/sf-friends.js",
            "src": "/guides/sf-friends.js"
        },
        {
            "dest": "/guides/sf-recap.js",
            "src": "/guides/sf-recap.js"
        },
        {
            "dest": "/guides/sf-vacations.js",
            "src": "/guides/sf-vacations.js"
        },
        {
            "dest": "/guides/sf-share.js",
            "src": "/guides/sf-share.js"
        },
        {
            "dest": "app.py",
            "src": "/(.*)"
        }
    ],
    "version": 2
}
